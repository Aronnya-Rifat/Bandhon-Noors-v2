DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
ENVIRONMENT=production
DEBUG=false
CUSTOMER_ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=https://www.example.com,https://example.com
ALLOWED_HOSTS=api.example.com
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600
FRONTEND_URL=https://www.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
ORDER_NOTIFICATION_EMAIL=orders@example.com
# Local: uploads
# Production persistent disk example:
# /var/data/bandhon-noors/uploads
UPLOAD_DIR=uploads

MEDIA_URL_PATH=/uploads
BACKEND_URL=https://api.example.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=false
