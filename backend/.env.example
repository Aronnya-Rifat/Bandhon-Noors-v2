DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
ENVIRONMENT=production
DEBUG=false
CUSTOMER_ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=https://www.example.com,https://example.com
ALLOWED_HOSTS=api.example.com
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600
